{
  "name": "lickabrick.github.io",
  "version": "1.0.0",
  "private": true,
  "description": "LickABrick's personal technical blog and notes",
  "license": "ISC",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "start": "npm run build:css && run-p dev:*",
    "dev:11ty": "eleventy --serve --port 8888",
    "dev:css": "tailwindcss -i src/assets/css/tailwind.css -o .cache/tailwind.css --watch=always",
    "build": "npm run clean && npm run build:css && npm run build:11ty",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('_site', { recursive: true, force: true });\"",
    "build:css": "tailwindcss -i src/assets/css/tailwind.css -o .cache/tailwind.css --minify",
    "build:11ty": "eleventy",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "test": "npm run build && node --test",
    "test:site": "node --test"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.7",
    "@11ty/eleventy-plugin-syntaxhighlight": "5.0.2",
    "@eslint/js": "10.0.1",
    "@tailwindcss/cli": "4.3.3",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "linkedom": "0.18.14",
    "npm-run-all2": "9.0.4",
    "tailwindcss": "4.3.3"
  }
}
