---
layout: base
title: Snippets
description: Practical commands, scripts and procedures for everyday systems work.
permalink: /snippets/
---
{% from "partials/entry.njk" import render as renderEntry %}
<header class="page-intro"><p class="eyebrow">Reference library</p><h1>Snippets</h1><p>{{ description }}</p></header>
<div data-content-search="snippet" data-index="/snippet-search.json">
{% from "partials/search-controls.njk" import render as searchControls %}
{{ searchControls("snippets", collections.snippet, "Try pfx or unattended-upgrades") }}
<div class="entry-list" id="snippets-results">
{% set entryType = "snippet" %}{% set entryHeading = 2 %}{% set entryVariant = "full" %}
{% for entry in collections.snippet | newestFirst %}
  {{ renderEntry(entry, entryType, entryVariant, entryHeading) }}
{% else %}<p>No snippets published yet.</p>{% endfor %}
</div>
</div>
<noscript><p>All snippets are listed above. Use your browser's Find command to search this page.</p></noscript>
<script defer src="/assets/js/content-search.js"></script>
