---
layout: base
title: Snippets
description: Practical commands, scripts and procedures for everyday systems work.
permalink: /snippets/
---
<header class="page-intro"><p class="eyebrow">Reference library</p><h1>Snippets</h1><p>{{ description }}</p></header>
<form id="snippet-search" class="search-controls" hidden role="search" aria-label="Find snippets">
  <div><label for="query">Search commands and content</label><input id="query" aria-controls="snippet-results" type="search" autocomplete="off" placeholder="Try pfx or unattended-upgrades"></div>

  <div><label for="tag">Tag</label><select id="tag" aria-controls="snippet-results"><option value="">All tags</option>{% for tag in collections.snippet | snippetTags %}<option value="{{ tag.slug }}">{{ tag.label }}</option>{% endfor %}</select></div>
  <button type="reset">Reset</button>
</form>
<p id="search-status" class="meta" role="status" hidden></p>
<div class="entry-list" id="snippet-results">
{% set isSnippet = true %}{% set headingLevel = 2 %}{% set compactPreview = false %}
{% for entry in collections.snippet | newestFirst %}
  {% include "partials/entry.njk" %}
{% else %}<p>No snippets published yet.</p>{% endfor %}
</div>
<noscript><p>All snippets are listed above. Use your browser's Find command to search titles and descriptions.</p></noscript>
<script defer src="/assets/js/snippets.js"></script>
