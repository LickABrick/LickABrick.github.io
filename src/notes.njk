---
layout: base
title: Notes
tags: page
description: Handy notes I refer to in my day-to-day life
---
<h1 class="text-2xl text-theme-300 mb-6">Notes</h1>
<div class="flex flex-col gap-6">
    {% for note in collections.note | newestFirst %}
    <div class="flex flex-col gap-2">
        <a class="text-2xl font-semibold text-theme-300" href="{{ note.url }}">{{ note.data.title }}</a>
        <p class="pb-4 text-neutral-50">{{ note.data.description }}</p>
        {% if note.data.publish_date %}
        <time class="text-theme-300 self-end" datetime="{{ note.data.publish_date | publishedISO }}">{{ note.data.publish_date }}</time>
        {% endif %}
        <hr class="border-theme-300">
    </div>
    {% endfor %}
</div>