---
layout: base
pagination:
  data: collections.publicTags
  size: 1
  alias: tag
  addAllPagesToCollections: true
permalink: "/tags/{{ tag.slug }}/"
eleventyComputed:
  title: "{{ tag.label }}"
  description: "Posts and practical snippets tagged {{ tag.label }}."
---
{% from "partials/entry.njk" import render as renderEntry %}
<header class="page-intro"><p class="eyebrow">Tag archive</p><h1>{{ tag.label }}</h1><p>{{ description }}</p></header>
{% if tag.posts.length %}
<section class="index-section" aria-labelledby="tag-posts">
  <div class="section-heading"><h2 id="tag-posts">Posts</h2><a href="/posts/">All Posts</a></div>
  <div class="entry-list">
  {% set entryType = "post" %}{% set entryHeading = 3 %}{% set entryVariant = "full" %}
  {% for entry in tag.posts %}{{ renderEntry(entry, entryType, entryVariant, entryHeading) }}{% endfor %}
  </div>
</section>
{% endif %}
{% if tag.snippets.length %}
<section class="index-section" aria-labelledby="tag-snippets">
  <div class="section-heading"><h2 id="tag-snippets">Snippets</h2><a href="/snippets/?tag={{ tag.slug }}">Find matching Snippets</a></div>
  <div class="entry-list">
  {% set entryType = "snippet" %}{% set entryHeading = 3 %}{% set entryVariant = "compact" %}
  {% for entry in tag.snippets %}{{ renderEntry(entry, entryType, entryVariant, entryHeading) }}{% endfor %}
  </div>
</section>
{% endif %}
