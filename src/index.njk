---
layout: base
title: Technical articles
description: Technical articles on PowerShell, automation and system administration.
tags: page
---

<h1 class="text-2xl text-theme-300 mb-6">Posts</h1>
<div class="flex flex-col gap-6">
    {% for post in collections.post | newestFirst %}
    <div class="flex flex-col gap-2">
        <a class="text-2xl font-semibold text-theme-300" href="{{ post.url }}">{{ post.data.title }}</a>
        <p class="text-neutral-50 pb-4">{{ post.data.description }}</p>
        {% if post.data.publish_date %}
        <time class="text-theme-300 self-end" datetime="{{ post.data.publish_date | publishedISO }}">{{ post.data.publish_date }}</time>
        {% endif %}
        <hr class="border-theme-300">
    </div>
    {% endfor %}
</div>