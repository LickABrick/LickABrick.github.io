---
layout: base
---
<article>
  <header>
    <h1 class="text-2xl font-semibold text-theme-300">{{ title }}</h1>
    <p>{{ description }}</p>
    {% if publish_date %}<time class="text-theme-300" datetime="{{ publish_date | publishedISO }}">{{ publish_date }}</time>{% endif %}
    <hr class="mt-4">
  </header>
  {{ content | safe }}
</article>
