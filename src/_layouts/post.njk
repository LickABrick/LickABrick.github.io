---
layout: base
---
<article>
  <header>
    {% if platform %}<p class="meta">{{ platform }}</p>{% endif %}
    <h1>{{ title }}</h1>
    <p>{{ description }}</p>
    {% set published = page.date %}{% set modified = last_modified %}{% set verified = last_verified %}{% set compact = false %}
    {% include "partials/dates.njk" %}
    {% set tagLimit = 0 %}{% include "partials/tags.njk" %}
  </header>
  {{ content | safe }}
</article>
