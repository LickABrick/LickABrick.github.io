<section class="entry{% if compactPreview %} entry-compact{% endif %}"{% if isSnippet and not compactPreview %} data-snippet-url="{{ entry.url }}"{% endif %}>
  {% if not isSnippet %}
  {% set published = entry.date %}{% set modified = entry.data.last_modified %}{% set verified = false %}{% set compact = false %}
  {% include "partials/dates.njk" %}{% endif %}
  {% if headingLevel == 3 %}<h3><a href="{{ entry.url }}">{{ entry.data.title }}</a></h3>{% else %}<h2><a href="{{ entry.url }}">{{ entry.data.title }}</a></h2>{% endif %}
  {% if not compactPreview %}<p>{{ entry.data.description }}</p>{% endif %}
  {% set tags = entry.data.tags %}{% set tagLimit = 0 %}{% if compactPreview %}{% set tagLimit = 2 %}{% endif %}{% include "partials/tags.njk" %}
  {% if isSnippet and not compactPreview %}
    {% set published = entry.date %}{% set modified = entry.data.last_modified %}{% set verified = entry.data.last_verified %}{% set compact = true %}
    {% include "partials/dates.njk" %}
  {% endif %}
</section>
